{
  "name": "rdo-rpg-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "RDO-RPG Discord Activity Multiplayer RPG Monorepo",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "dev:server": "pnpm --filter @rdo-rpg/server dev",
    "dev:client": "pnpm --filter @rdo-rpg/client dev",
    "build": "pnpm --filter ./packages/* build && pnpm --filter ./apps/* build",
    "build:shared": "pnpm --filter @rdo-rpg/shared build",
    "build:content": "pnpm --filter @rdo-rpg/content build",
    "build:server": "pnpm --filter @rdo-rpg/server build",
    "build:client": "pnpm --filter @rdo-rpg/client build",
    "test:e2e": "node scripts/e2e-check.mjs",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.1.0"
}
