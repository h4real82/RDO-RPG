{
  "$ref": "#/definitions/WorldManifest",
  "definitions": {
    "WorldManifest": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "world": {
          "type": "string",
          "const": "valentine"
        },
        "placements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "asset": {
                "type": "string",
                "pattern": "^models\\/(?:[A-Za-z0-9][A-Za-z0-9._-]*\\/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.glb$"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              "rotation": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              "scale": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              "layer": {
                "type": "string",
                "enum": [
                  "terrain",
                  "roadsAndRails",
                  "boardwalks",
                  "buildings"
                ]
              },
              "chunkId": {
                "type": "string",
                "pattern": "^-?\\d+:-?\\d+$"
              },
              "lod": {
                "type": "integer",
                "minimum": 0
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "asset",
              "position",
              "rotation",
              "scale",
              "layer",
              "chunkId",
              "lod"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "world",
        "placements"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
